# Имя проекта в Docker — чтобы контейнеры не путались с другими стендами
COMPOSE_PROJECT_NAME=ntbank

# Профиль по умолчанию: полный стенд (банк, PostgreSQL, Kafka, «Антифрод»).
# Облегчённый запуск: docker compose --profile lite up -d --build
COMPOSE_PROFILES=full

# Объём истории операций. По умолчанию ~125 тысяч (50–200 на клиента).
# Для дефекта «Нет индекса» нужен реалистичный объём — раскомментируйте:
# SEED_OPERATIONS_TOTAL=2000000
